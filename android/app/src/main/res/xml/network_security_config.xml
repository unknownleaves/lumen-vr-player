<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed so the app can reach a Lumen server (ZimaOS / NAS) on the home network. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
